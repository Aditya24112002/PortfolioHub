"use client";

import { useState, useEffect } from "react";

export default function ThemeSwitcher() {

  const [theme, setTheme] = useState("dark");

  useEffect(() => {

    document.documentElement.setAttribute(
      "data-theme",
      theme
    );

  }, [theme]);

  const changeTheme = () => {

    if (theme === "dark") {
      setTheme("light");
    } else {
      setTheme("dark");
    }

  };

  return (
    <button
      onClick={changeTheme}
      className="cursor-pointer rounded-lg border px-4 py-2"
    >
      {theme === "dark" ? "🌙" : "☀️"}
    </button>
  );
}